# ============================================================
# MCP Server 工具调用测试（STATELESS Streamable HTTP）
# 端点: http://localhost:8081/mcp
# 前置条件: 应用已启动（mvn spring-boot:run 或 java -jar target\spring-ai-rag-1.0-SNAPSHOT.jar）
# 协议: JSON-RPC 2.0，每个请求独立无会话
# ============================================================

###
# 1. MCP 握手 initialize（验证端点存活 + 服务信息）
POST http://localhost:8081/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-03-26",
    "capabilities": {},
    "clientInfo": {
      "name": "idea-http-client",
      "version": "1.0"
    }
  }
}

###
# 2. 列出已发布的 MCP 工具
# 期望结果: getWeather / searchKnowledgeBase 两个工具
POST http://localhost:8081/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

###
# 3. 调用天气工具 getWeather（实时高德数据）
POST http://localhost:8081/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "getWeather",
    "arguments": {
      "location": "西安"
    }
  }
}

###
# 4. 调用知识库检索工具 searchKnowledgeBase
# 注意: 依赖 Milvus 向量库，本地未部署 Milvus 时会失败（属正常现象）
POST http://localhost:8081/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "searchKnowledgeBase",
    "arguments": {
      "query": "大学生创业有哪些优惠政策"
    }
  }
}